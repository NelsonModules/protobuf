  <language>fr_FR</language>
  <keyword>protobuf.totext</keyword>
  <short_description>Format texte protobuf d'un message.</short_description>
  <syntax>
    <syntax_item>txt = protobuf.totext(schema, type, value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>schema, type</param_name>
      <param_description>un schéma de protobuf.load et un type de message.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>un message donné en structure ou en octets uint8 encodés.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>txt</param_name>
      <param_description>un vecteur de caractères : le message au format texte protobuf.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>protobuf.totext écrit un message au format texte Protocol Buffers ("name: value", "name { }" imbriqué), la forme utilisée par protoc --decode. protobuf.fromtext le relit.</p>
    <p>Pour afficher plusieurs enregistrements d'un coup, utiliser protobuf.show.</p>
  </description>
  <used_function />
  <bibliography>Documentation Protocol Buffers : https://protobuf.dev</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Format texte d'un message</example_item_description>
      <example_item_data runnable="cli"><![CDATA[schema = protobuf.load([modulepath('protobuf'), '/tests/data/sensor_stream.proto']);
record = struct('timestamp_ms', 1000, 'status', 1, 'diagnostics', struct('drift', 0.5));
disp(protobuf.totext(schema, 'SensorSample', record))
]]></example_item_data>
    </example_item>
  </examples>
